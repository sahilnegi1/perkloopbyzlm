# ---------------------------------------------------------------------------
# Perk Loop — environment variables
# Copy this file to `.env` and adjust values.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------
# Production: Supabase Postgres. DATABASE_URL = transaction pooler (port 6543,
# used by the app at runtime). DIRECT_URL = session pooler (port 5432, used by
# prisma db push / migrate). Both come from the "Connect" dialog in Supabase.
# DATABASE_URL="postgresql://postgres.<ref>:<pass>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:<pass>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
#
# Local dev / sandbox preview: `bun run dev` automatically uses the committed
# prisma/schema.sqlite.prisma (SQLite) — no manual provider switching needed.
# prisma/schema.prisma stays PostgreSQL for production (Vercel + Supabase).
DATABASE_URL="file:./db/custom.db"

# --- Required in production -----------------------------------------------
# 32+ char random strings. Generate with: openssl rand -hex 32
# Dev fallbacks exist, but production builds must set both explicitly.
# SESSION_SECRET=change-me-openssl-rand-hex-32
# OTP_SALT=change-me-openssl-rand-hex-32

# --- Optional: OTP delivery (DEV MODE shows codes in the UI when unset) ----
# Email via Brevo SMTP (recommended for pilot: 300 free emails/day).
# First add + verify your domain in Brevo (SPF/DKIM/DMARC) or OTP lands in spam.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-account-email
# SMTP_PASS=your-brevo-smtp-key
# SMTP_FROM="Perk Loop <otp@yourdomain.in>"

# Or email via Resend HTTP API:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# SMTP_FROM="Perk Loop <otp@yourdomain.in>"

# SMS via Twilio (set one of FROM_NUMBER or MESSAGING_SERVICE_SID):
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+91xxxxxxxxxx
# TWILIO_MESSAGING_SERVICE_SID=...
